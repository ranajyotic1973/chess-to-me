{"nodes": [{"id": "openspec_changes_archive_2026_07_03_improve_line_detail_and_llm_analysis_design_change_redesign", "label": "Redesign: Line Detail as Board-Move History (Change)", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-07-03-improve-line-detail-and-llm-analysis/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Previous design tracked a selected engine line's future moves, which was error-prone (unclear if the user would follow the suggestion, confusing highlighting of unplayed moves, complex line-switch state, and LLM analyzing all lines wastefully). Redesign treats Line Detail as a simple played-move history: only moves made on the board are stored/shown, engine lines are matched via O(1) move-sequence hashing, line selection per board position (FEN) is tracked for accurate backward navigation, and LLM analysis is scoped to the single selected line."}], "edges": [{"source": "openspec_changes_archive_2026_07_03_improve_line_detail_and_llm_analysis_design_change_redesign", "target": "openspec_changes_archive_2026_07_03_improve_line_detail_and_llm_analysis_specs_board_move_tracking_spec_board_move_tracking", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-07-03-improve-line-detail-and-llm-analysis/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_07_03_improve_line_detail_and_llm_analysis_design_change_redesign", "target": "openspec_changes_archive_2026_07_03_improve_line_detail_and_llm_analysis_specs_selected_line_tracking_spec_selected_line_tracking", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-07-03-improve-line-detail-and-llm-analysis/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_07_03_improve_line_detail_and_llm_analysis_design_change_redesign", "target": "openspec_changes_archive_2026_07_03_improve_line_detail_and_llm_analysis_specs_line_selection_history_spec_line_selection_history", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-07-03-improve-line-detail-and-llm-analysis/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_07_03_improve_line_detail_and_llm_analysis_design_change_redesign", "target": "openspec_changes_archive_2026_07_03_improve_line_detail_and_llm_analysis_specs_line_detail_display_spec_line_detail_display", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-07-03-improve-line-detail-and-llm-analysis/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_07_03_improve_line_detail_and_llm_analysis_design_change_redesign", "target": "openspec_changes_archive_2026_07_03_improve_line_detail_and_llm_analysis_specs_line_specific_llm_analysis_spec_line_specific_llm_analysis", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-07-03-improve-line-detail-and-llm-analysis/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_07_03_improve_line_detail_and_llm_analysis_design_change_redesign", "target": "openspec_changes_archive_2026_07_03_improve_line_detail_and_llm_analysis_tasks_lineselectionhistory_redux_state", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-07-03-improve-line-detail-and-llm-analysis/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_07_03_improve_line_detail_and_llm_analysis_specs_board_move_tracking_spec_board_move_tracking", "target": "openspec_changes_archive_2