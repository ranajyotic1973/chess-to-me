{"nodes": [{"id": "openspec_changes_archive_2026_07_04_refactor_advanced_analysis_notes_design_change_notes_refactor", "label": "Refactor Advanced Analysis Notes (Change)", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-07-04-refactor-advanced-analysis-notes/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces a separate, disconnected Notes panel with per-move markdown notes integrated into line details via a click-to-edit two-popup workflow (AI-import confirmation dialog then markdown editor). Notes are stored as markdown keyed by move index inside the line's move array (not a separate global map) so they travel automatically with the line; the editor uses a modal for focus and toolbar space; PGN export embeds each move's markdown notes using standard PGN comment syntax `{markdown}` for interoperability."}], "edges": [{"source": "openspec_changes_archive_2026_07_04_refactor_advanced_analysis_notes_design_change_notes_refactor", "target": "openspec_changes_archive_2026_07_04_refactor_advanced_analysis_notes_specs_move_level_notes_spec_move_level_notes", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-07-04-refactor-advanced-analysis-notes/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_07_04_refactor_advanced_analysis_notes_design_change_notes_refactor", "target": "openspec_changes_archive_2026_07_04_refactor_advanced_analysis_notes_specs_markdown_note_editor_spec_markdown_note_editor", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/archive/2026-07-04-refactor-advanced-analysis-notes/design.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_archive_2026_07_04_refactor_advanced_analysis_notes_design_change_notes_refactor", "target": "openspec_cha