{
  "name": "chess-to-me",
  "version": "0.1.0",
  "private": true,
  "description": "Electron + React local Stockfish chess trainer",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "cross-env BROWSER=none vite --strictPort --port 5173 --host 127.0.0.1",
    "dev:electron": "npm run build:electron && wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://127.0.0.1:5173 electron .",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && move electron\\dist\\electron\\*.js electron\\dist\\ && move electron\\dist\\electron\\*.js.map electron\\dist\\ && move electron\\dist\\electron\\*.d.ts electron\\dist\\ && move electron\\dist\\electron\\*.d.ts.map electron\\dist\\ && rmdir electron\\dist\\electron",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "electron .",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "prepare:installer-assets": "powershell -ExecutionPolicy Bypass -File scripts/prepare-installer-assets.ps1",
    "dist:win": "npm run build && electron-builder --win nsis",
    "nsis:version": ".\\tools\\nsis\\makensis.exe /VERSION",
    "fetch:mega-reference-db": "powershell -ExecutionPolicy Bypass -File scripts/fetch-mega-reference-db.ps1",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "build:games-db": "node scripts/build-games-db.js"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "@emotion/react": "^11.13.1",
    "@emotion/styled": "^11.13.0",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/sora": "^5.2.8",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^11.10.0",
    "chess.js": "^1.4.0",
    "chessboardjs": "^0.0.1",
    "fzstd": "^0.1.1",
    "jquery": "^4.0.0",
    "node-7z": "^3.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-typescript": "^7.28.5",
    "@electron/rebuild": "^4.0.4",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/jquery": "^4.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "babel-jest": "^29.7.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^34.5.8",
    "electron-builder": "^26.8.1",
    "jest": "^29.7.0",
    "sql.js": "^1.14.1",
    "typescript": "^6.0.3",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.xalgo.chess-to-me",
    "productName": "Chess To Me",
    "icon": "build/icon.ico",
    "files": [
      "dist/**/*",
      "electron/dist/**/*",
      "data/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "data/games",
        "to": "games-db",
        "filter": [
          "*.db"
        ]
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  }
}
