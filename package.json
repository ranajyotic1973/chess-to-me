{
  "name": "chess-to-me",
  "version": "1.0.0",
  "private": true,
  "description": "Electron + React local Stockfish chess trainer",
  "license": "MIT",
  "author": {
    "name": "Chess To Me contributors",
    "email": "ranajyotic@gmail.com"
  },
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "cross-env BROWSER=none vite --strictPort --port 5173 --host 127.0.0.1",
    "dev:electron": "npm run build:electron && wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://127.0.0.1:5173 electron .",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/flatten-electron-dist.js",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "electron .",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "prepare:installer-assets": "powershell -ExecutionPolicy Bypass -File scripts/prepare-installer-assets.ps1",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:win:arm64": "npm run build && electron-builder --win --arm64",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux --x64",
    "dist:linux:arm64": "npm run build && electron-builder --linux --arm64",
    "nsis:version": ".\\tools\\nsis\\makensis.exe /VERSION",
    "fetch:mega-reference-db": "powershell -ExecutionPolicy Bypass -File scripts/fetch-mega-reference-db.ps1",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "rebuild:native:arm64": "electron-rebuild -f -w better-sqlite3 --arch arm64",
    "build:games-db": "node scripts/build-games-db.js",
    "build:icons": "node scripts/build-icons.js"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "@chess-openings/eco.json": "^2.0.4",
    "@emotion/react": "^11.13.1",
    "@emotion/styled": "^11.13.0",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/sora": "^5.2.8",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^11.10.0",
    "chess.js": "^1.4.0",
    "chessboardjs": "^0.0.1",
    "fzstd": "^0.1.1",
    "jquery": "^4.0.0",
    "node-7z": "^3.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-typescript": "^7.28.5",
    "@electron/rebuild": "^4.0.4",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/jquery": "^4.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "babel-jest": "^29.7.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^34.5.8",
    "electron-builder": "^26.8.1",
    "jest": "^29.7.0",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.1",
    "sql.js": "^1.14.1",
    "typescript": "^6.0.3",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.xalgo.chess-to-me",
    "productName": "Chess To Me",
    "copyright": "Copyright © 2025 Chess To Me contributors",
    "artifactName": "chess-to-me-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "electron/dist/**/*",
      "data/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/better-sqlite3/**/*.node",
      "**/7zip-bin/**",
      "**/node_modules/7zip-bin/**"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "data/games",
        "to": "games-db",
        "filter": [
          "*.db"
        ]
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.education",
      "x64ArchFiles": "**/7zip-bin/**",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Education",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1"
      ]
    }
  }
}
